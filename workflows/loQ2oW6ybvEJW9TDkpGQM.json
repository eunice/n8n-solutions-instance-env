    {
      "parameters": {
        "jsCode": "// Explode insurance data into rows: company, insurance category, value\nconst allData = $input.all();\nconst rows = [];\nconsole.log('allData', allData)\n\n// Process each item from the loop\nfor (const item of allData) {\n  const data = item.json.output;\n  const company = data.companyName;\n  \n  // Create a row for each insurance category\n  const categories = [\n    { category: \"General Liability\", value: data.generalLiability },\n    { category: \"Professional Liability\", value: data.professionalLiability },\n    { category: \"Workers Compensation\", value: data.workersCompensation },\n    { category: \"Auto Insurance\", value: data.autoInsurance },\n    { category: \"Umbrella Policy\", value: data.umbrellaPolicy }\n  ];\n  \n  // Add each category as a separate row\n  for (const cat of categories) {\n    rows.push({\n      json: {\n        company: company,\n        insuranceCategory: cat.category,\n        value: cat.value\n      }\n    });\n  }\n}\n\nreturn rows;"
      },
