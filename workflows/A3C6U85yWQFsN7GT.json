    {
      "parameters": {
        "jsonSchemaExample": "{\n\"billed_to\": \"John\",\n\"invoice_number\": \"569871234\",\n\"date_of_issue\": \"2025-05-21\",\n\"due_date\": \"2025-05-25\",\n\"item_0_description\": \"Computer CPU\",\n\"item_0_quantity\": 6,\n\"item_0_rate\": 15,\n\"item_0_amount\": 90,\n\"item_1_description\": \"Chair Wooden\",\n\"item_1_quantity\": 8,\n\"item_1_rate\": 10,\n\"item_1_amount\": 80,\n\"subtotal\": 170.00,\n\"discount\": 20.00,\n\"total\": 150.00,\n\"terms\": \"Sold items not be acceptable\",\n\"conditions_instructions\": \"xyaABC\",\n\"company_name\": \"Digital Electronics\",\n\"company_mobile\": \"987654321\",\n\"company_email\": \"ayz@gmail.com\",\n\"company_website\": \"www.abc.com\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -416,
        336
      ],
      "id": "d2407a77-e212-4695-b5ff-c7c26de8e493",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Grab output from the node 2 steps back\nconst output = $('Invoice AI Agent').item.json.output;\n\nconst results = [];\nlet index = 0;\n\n// Loop through all item_* fields dynamically\nwhile (typeof output[`item_${index}_description`] === 'string') {\n  results.push({\n    json: {\n      invoice_number: output.invoice_number,\n      company: output.company_name,\n      date_of_issue: output.date_of_issue,\n      due_date: output.due_date,\n      item_description: output[`item_${index}_description`],\n      quantity: output[`item_${index}_quantity`],\n      rate: output[`item_${index}_rate`],\n      amount: output[`item_${index}_amount`],\n      invoice_total: output.total\n    }\n  });\n  index++;\n}\n\nreturn results;\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
